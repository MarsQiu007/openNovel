{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@opennovel-ai/novel-store",
  "version": "0.0.8",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "test": "bun test --timeout 30000 --only-failures",
    "build": "tsc"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "imports": {
    "#driver": {
      "bun": "./src/driver.bun.ts",
      "node": "./src/driver.node.ts",
      "default": "./src/driver.bun.ts"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "drizzle-orm": "catalog:",
    "@opennovel-ai/schema": "workspace:*",
    "effect": "catalog:",
    "xdg-basedir": "5.1.0"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@tsconfig/node22": "catalog:",
    "typescript": "catalog:",
    "@typescript/native-preview": "catalog:"
  }
}
